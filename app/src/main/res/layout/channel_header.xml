<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

            <TextView
                android:id="@+id/chName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:focusable="true"
                android:textColor="#EAF5F3"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#A4BCC0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:focusable="true"
                android:clickable="true"
                android:textColor="#C9DADD"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/chSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:background="@drawable/pill_bg_on"
                android:textColor="#09161A"
                android:text="সাবস্ক্রাইব"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sortRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnBackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:background="@drawable/pill_bg"
                android:textColor="#EAF5F3"
                android:text="প্লেলিস্টের তালিকায় ফিরুন"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#A4BCC0"
                android:textSize="15sp"
                android:accessibilityLiveRegion="polite" />
</LinearLayout>
