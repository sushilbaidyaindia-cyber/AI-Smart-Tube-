<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09161A">

    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/spin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/fsBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="#99000000"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/fsRew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_rew"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/fsPlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/fsFwd"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/fsExit"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="পূর্ণ পর্দা থেকে বের হোন"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:focusable="true"
                android:textColor="#EAF5F3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#A4BCC0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:textColor="#FFB84A"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/bPrev"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="আগের ভিডিও"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="#EAF5F3" />

                <ImageButton
                    android:id="@+id/bRew"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="পিছিয়ে যান"
                    android:src="@android:drawable/ic_media_rew"
                    android:tint="#EAF5F3" />

                <ImageButton
                    android:id="@+id/bPlay"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="চালান"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#FFB84A" />

                <ImageButton
                    android:id="@+id/bFwd"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="এগিয়ে যান"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="#EAF5F3" />

                <ImageButton
                    android:id="@+id/bNext"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="পরের ভিডিও"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="#EAF5F3" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:contentDescription="ভিডিওর সময়" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#A4BCC0"
                android:textSize="14sp"
                android:importantForAccessibility="no" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Button
                    android:id="@+id/bChan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:background="@drawable/pill_bg"
                    android:textColor="#EAF5F3"
                    android:text="চ্যানেল দেখুন" />

                <Button
                    android:id="@+id/bSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:background="@drawable/pill_bg_on"
                    android:textColor="#09161A"
                    android:text="সাবস্ক্রাইব" />
            </LinearLayout>

            <Button
                android:id="@+id/bWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:background="@drawable/pill_bg"
                android:textColor="#EAF5F3"
                android:text="AI সহায়তা (সারাংশ, অনুবাদ, প্রশ্ন, দৃশ্য বর্ণনা)" />

            <TextView
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:focusable="true"
                android:clickable="true"
                android:textColor="#C9DADD"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/upHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:text="এরপর"
                android:textColor="#EAF5F3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upnext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:contentDescription="পরের ভিডিওর তালিকা" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
