<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09161A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Smart Tube"
            android:textColor="#EAF5F3"
            android:textSize="24sp"
            android:textStyle="bold"
            android:contentDescription="এআই স্মার্ট টিউব সেটআপ" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google দিয়ে লগইন করলে আপনার সাবস্ক্রিপশন, লাইক ও প্লেলিস্ট এখানে পাবেন"
            android:textColor="#A8C5C0"
            android:textSize="16sp"
            android:contentDescription="Google দিয়ে লগইন করলে আপনার সাবস্ক্রিপশন, লাইক ও প্লেলিস্ট এখানে পাবেন" />

        <!-- Step 1: two big choices -->
        <LinearLayout
            android:id="@+id/choiceBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Google দিয়ে লগইন"
                android:contentDescription="Google দিয়ে লগইন করুন"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="এমনি চালিয়ে যান"
                android:contentDescription="এমনি চালিয়ে যান। লগইন ছাড়া সাধারণ ব্যবহার।"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
